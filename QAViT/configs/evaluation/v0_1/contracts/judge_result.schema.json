{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qavit.eval_l0.judge_result.v0_1",
  "title": "QAViT Eval-L0 Offline Judge Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "rubric_id", "role", "purpose", "criteria", "strengths", "weaknesses", "critical_flags", "overall_confidence"],
  "properties": {
    "schema_version": {"const": "qavit.eval_l0.judge_result/1"},
    "case_id": {"type": "string", "minLength": 1},
    "rubric_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["generation", "judger", "evolution", "recorder", "coding", "safeguard"]},
    "purpose": {"enum": ["generate", "screen", "position", "arbitrate", "rank", "plan_l3", "interpret", "evolve", "record", "code", "safeguard"]},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "status", "score", "rationale", "evidence_refs", "confidence"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[A-Z]{1,2}[A-Z0-9]+$"},
          "status": {"enum": ["scored", "not_applicable", "unknown"]},
          "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
          "rationale": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_pointer"}},
          "confidence": {"enum": ["high", "medium", "low"]}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "scored"}}, "required": ["status"]}, "then": {"properties": {"score": {"type": "integer"}}}},
          {"if": {"properties": {"status": {"enum": ["not_applicable", "unknown"]}}, "required": ["status"]}, "then": {"properties": {"score": {"type": "null"}}}}
        ]
      }
    },
    "strengths": {"type": "array", "items": {"type": "string"}},
    "weaknesses": {"type": "array", "items": {"type": "string"}},
    "critical_flags": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "description", "evidence_refs", "confidence"],
        "properties": {
          "kind": {"enum": ["fabricated_measurement", "misattributed_evidence", "scope_overclaim", "constraint_violation", "data_leakage", "unjustified_rejection", "unsupported_approval", "other"]},
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_pointer"}},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "overall_confidence": {"enum": ["high", "medium", "low"]}
  },
  "$defs": {
    "evidence_pointer": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string"}
      }
    }
  }
}
