# Stable source, prompts, configuration, tests and documentation are tracked
# normally. Only EXP uses an exact file allowlist.

# Existing local dependencies and read-only assets stay on disk.
/QAViT/.runtime_pkgs/
/QAViT/configs/assets/imagenet_manifest.json
/reference/
/data/
/datasets/
/weights/
/checkpoints/
/QAViT/data/
/QAViT/datasets/
/QAViT/weights/
/QAViT/checkpoints/

# Ignore every EXP artifact unless its exact path has been reviewed below.
/EXP/**
!/EXP/implementation/
!/EXP/implementation/v2_structure_20261027/
!/EXP/implementation/v2_structure_20261027/REPORT.md
!/EXP/validation/
!/EXP/validation/research_refactor_20261103_r1/
!/EXP/validation/research_refactor_20261103_r1/REPORT.md
!/EXP/validation/research_refactor_20261103_r1/PSEUDOCODE.md
!/EXP/validation/research_refactor_20261103_r1/DELIVERY.json
!/EXP/validation/research_refactor_20261103_r1/REPLAY_RESULT.json
!/EXP/validation/research_refactor_20261103_r1/complexity.json

